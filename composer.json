{
    "name": "ggiovanini/laravel-whatsapp",
    "version": "0.1.0",
    "description": "A Whatsapp Business Cloud API wrapper for Laravel.",
    "keywords": [
        "laravel",
        "whatsapp",
        "facebook",
        "sdk",
        "api"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MissaelAnda\\Whatsapp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Missael H. Anda",
            "email": "missael.anda@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/events": "^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MissaelAnda\\Whatsapp\\WhatsappServiceProvider"
            ],
            "aliases": {
                "Whatsapp": "MissaelAnda\\Whatsapp\\Facade\\Whatsapp"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}